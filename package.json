{
  "name": "handspan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Record-once / replay-many UI automation for legacy back-office banking apps.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "app": "tsx target-app/server.ts",
    "discover": "tsx src/cli.ts discover",
    "replay": "tsx src/cli.ts replay",
    "catalog": "tsx src/cli.ts catalog",
    "invoke": "tsx src/cli.ts invoke",
    "operator": "tsx src/cli.ts operator",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "capability": "tsx src/cli.ts capability",
    "green": "tsx target-app/green-screen.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "playwright": "^1.47.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
