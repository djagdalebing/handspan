      "intent": "Submit the sign-on form",
      "action": {
        "kind": "click",
        "target": {
          "role": "button",
          "name": "Sign On",
          "nameMatch": "exact",
          "framePath": []
        }
      },
      "risk": "safe",
      "waitFor": {
        "type": "nodeExists",
        "target": {
          "role": "textbox",
          "name": "Member Number",
          "nameMatch": "exact",
          "framePath": [
            "main"
          ]
        }
