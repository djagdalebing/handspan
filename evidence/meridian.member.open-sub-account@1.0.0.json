{
  "schema": "capability/v1",
  "id": "meridian.member.open-sub-account",
  "version": "1.0.0",
  "name": "Open a member sub-account",
  "description": "Open a new sub-account of a given type for a member with an opening deposit, and return the confirmation number. This capability posts an irreversible transaction.",
  "app": {
    "vendor": "Meridian Systems",
    "product": "MERIDIAN Core Member Services",
    "productVersion": "7.2.1",
    "surface": "web"
  },
  "approval": "approved",
  "risk": "irreversible",
  "inputs": [
    {
      "name": "memberId",
      "type": "string",
      "required": true,
      "description": "The member number.",
      "sensitivity": "pii",
      "pattern": "^[0-9]{5}$",
      "example": "12345"
    },
    {
      "name": "accountType",
      "type": "enum",
      "enum": [
        "SHARE SAVINGS",
        "VACATION CLUB",
        "HOLIDAY CLUB"
      ],
      "required": true,
      "description": "The sub-account product to open.",
      "sensitivity": "internal",
      "example": "VACATION CLUB"
    },
    {
      "name": "openingDeposit",
      "type": "string",
      "required": true,
      "description": "Opening deposit amount in dollars. Minimum 25.",
      "sensitivity": "internal",
      "pattern": "^[0-9]+(\\.[0-9]{2})?$",
      "example": "50.00"
    }
  ],
  "outputs": [
    {
      "name": "confirmationNumber",
      "type": "string",
      "description": "Core confirmation number for the posting.",
      "source": {
        "from": "readout",
        "label": {
          "mode": "contains",
          "value": "Confirmation Number",
          "caseSensitive": false
        }
      },
      "transform": "trim",
      "required": true,
      "sensitivity": "internal"
    },
    {
      "name": "newAccountNumber",
      "type": "string",
      "description": "The account number assigned to the new sub-account.",
      "source": {
        "from": "readout",
        "label": {
          "mode": "contains",
          "value": "New Account Number",
          "caseSensitive": false
        }
      },
      "transform": "trim",
      "required": true,
      "sensitivity": "internal"
    }
  ],
  "preconditions": [],
  "steps": [
    {
      "id": "s00",
      "intent": "Open MERIDIAN Core Member Services at its entry point",
      "action": {
        "kind": "navigate",
        "url": "http://127.0.0.1:4311/"
      },
      "risk": "safe",
      "waitFor": {
        "type": "nodeExists",
        "target": {
          "role": "textbox",
          "name": "Operator ID",
          "nameMatch": "exact",
          "framePath": []
        }
      },
      "optional": false,
      "timeoutMs": 20000,
      "retry": {
        "attempts": 2,
        "backoffMs": 800
      }
    },
    {
      "id": "s01",
      "intent": "Enter the operator ID on the sign-on screen",
      "action": {
        "kind": "type",
        "target": {
          "role": "textbox",
          "name": "Operator ID",
          "nameMatch": "exact",
          "framePath": []
        },
        "secretRef": "MERIDIAN_OPERATOR_ID",
        "clearFirst": true
      },
      "risk": "safe",
      "waitFor": {
        "type": "nodeExists",
        "target": {
          "role": "textbox",
          "name": "Password",
          "nameMatch": "exact",
          "framePath": []
        }
      },
      "optional": false,
      "timeoutMs": 15000,
      "retry": {
        "attempts": 2,
        "backoffMs": 600
      }
    },
    {
