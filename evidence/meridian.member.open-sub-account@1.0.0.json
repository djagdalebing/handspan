          "role": "textbox",
          "name": "Member Number",
          "nameMatch": "exact",
          "framePath": [
            "main"
          ]
        },
        "text": "{{memberId}}",
        "clearFirst": true
      },
      "risk": "safe",
      "waitFor": {
        "type": "nodeExists",
        "target": {
          "role": "button",
          "name": "Search",
          "nameMatch": "exact",
          "framePath": [
            "main"
          ]
        }
      },
      "optional": false,
      "timeoutMs": 15000,
      "retry": {
        "attempts": 2,
        "backoffMs": 600
      }
    },
    {
      "id": "s05",
      "intent": "Run the member search",
      "action": {
        "kind": "click",
        "target": {
          "role": "button",
          "name": "Search",
          "nameMatch": "exact",
          "framePath": [
            "main"
          ]
        }
      },
      "risk": "safe",
      "waitFor": {
        "type": "nodeExists",
        "target": {
          "role": "link",
          "name": "Open Sub-Account",
          "nameMatch": "exact",
          "framePath": [
            "main"
          ]
        }
      },
      "optional": false,
      "timeoutMs": 15000,
      "retry": {
        "attempts": 2,
        "backoffMs": 600
      }
    },
    {
