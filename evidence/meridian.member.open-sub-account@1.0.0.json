      "intent": "Start the sub-account opening flow",
      "action": {
        "kind": "click",
        "target": {
          "role": "link",
          "name": "Open Sub-Account",
          "nameMatch": "exact",
          "framePath": [
            "main"
          ]
        }
      },
      "risk": "mutating",
      "waitFor": {
        "type": "nodeExists",
        "target": {
          "role": "combobox",
          "name": "Account Type",
          "nameMatch": "exact",
          "framePath": [
            "main"
          ]
        }
      },
      "optional": false,
      "timeoutMs": 15000,
      "retry": {
        "attempts": 2,
        "backoffMs": 600
      }
    },
    {
