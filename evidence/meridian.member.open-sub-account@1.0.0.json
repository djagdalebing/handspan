      "intent": "Enter the operator password on the sign-on screen",
      "action": {
        "kind": "type",
        "target": {
          "role": "textbox",
          "name": "Password",
          "nameMatch": "exact",
          "framePath": []
        },
        "secretRef": "MERIDIAN_OPERATOR_PASSWORD",
        "clearFirst": true
      },
      "risk": "safe",
      "waitFor": {
        "type": "nodeExists",
        "target": {
          "role": "button",
          "name": "Sign On",
          "nameMatch": "exact",
          "framePath": []
        }
      },
      "optional": false,
      "timeoutMs": 15000,
      "retry": {
        "attempts": 2,
        "backoffMs": 600
      }
    },
    {
