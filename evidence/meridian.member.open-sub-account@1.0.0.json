      "action": {
        "kind": "click",
        "target": {
          "role": "button",
          "name": "Continue",
          "nameMatch": "exact",
          "framePath": [
            "main"
          ]
        }
      },
      "risk": "safe",
      "waitFor": {
        "type": "nodeExists",
        "target": {
          "role": "button",
          "name": "Post Account",
          "nameMatch": "exact",
          "framePath": [
            "main"
          ]
        }
      },
      "optional": false,
      "timeoutMs": 15000,
      "retry": {
        "attempts": 2,
        "backoffMs": 600
      }
    },
    {
      "id": "s10",
      "intent": "Post the new sub-account (irreversible)",
      "action": {
        "kind": "click",
        "target": {
          "role": "button",
          "name": "Post Account",
          "nameMatch": "exact",
          "framePath": [
            "main"
          ]
        }
      },
      "risk": "irreversible",
      "waitFor": {
        "type": "all",
        "of": [
          {
            "type": "textMatches",
            "value": {
              "mode": "contains",
              "value": "SUB-ACCOUNT OPENED",
              "caseSensitive": false
            }
          },
          {
            "type": "readoutMatches",
            "label": {
              "mode": "contains",
              "value": "Confirmation Number",
              "caseSensitive": false
            },
            "value": {
              "mode": "regex",
              "value": ".",
              "caseSensitive": false
            }
          }
        ]
      },
      "optional": false,
      "timeoutMs": 15000,
      "retry": {
        "attempts": 2,
        "backoffMs": 600
      }
    }
  ],
