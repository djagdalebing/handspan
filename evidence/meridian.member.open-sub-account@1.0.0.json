        "target": {
          "role": "combobox",
          "name": "Account Type",
          "nameMatch": "exact",
          "framePath": [
            "main"
          ]
        },
        "option": "{{accountType}}"
      },
      "risk": "safe",
      "waitFor": {
        "type": "nodeExists",
        "target": {
          "role": "textbox",
          "name": "Opening Deposit",
          "nameMatch": "exact",
          "framePath": [
