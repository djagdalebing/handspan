        "kind": "type",
        "target": {
          "role": "textbox",
          "name": "Opening Deposit",
          "nameMatch": "exact",
          "framePath": [
            "main"
          ]
        },
        "text": "{{openingDeposit}}",
        "clearFirst": true
      },
      "risk": "safe",
      "waitFor": {
        "type": "nodeExists",
        "target": {
          "role": "button",
          "name": "Continue",
          "nameMatch": "exact",
          "framePath": [
            "main"
          ]
        }
      },
      "optional": false,
      "timeoutMs": 15000,
      "retry": {
        "attempts": 2,
        "backoffMs": 600
      }
    },
    {
