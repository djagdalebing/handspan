{
  "schema": "capability/v1",
  "id": "meridian.terminal.member-savings-balance",
  "version": "1.0.0",
  "name": "Read member savings balance (green screen)",
  "description": "Look up a member on the MERIDIAN green-screen terminal and return the current balance of their share savings account.",
  "app": {
    "vendor": "Meridian Systems",
    "product": "MERIDIAN Core Member Services",
    "productVersion": "7.2.1",
    "surface": "web"
  },
  "approval": "draft",
  "risk": "safe",
  "inputs": [
    {
      "name": "memberId",
      "type": "string",
      "required": true,
      "description": "The member number to look up.",
      "sensitivity": "pii",
      "pattern": "^[0-9]{5}$",
      "example": "«memberId#7e6282»"
    }
  ],
  "outputs": [
    {
      "name": "memberName",
      "type": "string",
      "description": "The member's name as held on the core.",
      "source": {
        "from": "readout",
        "label": {
          "mode": "contains",
          "value": "Member Name",
          "caseSensitive": false
        }
      },
      "transform": "trim",
      "required": true,
      "sensitivity": "pii"
    },
    {
      "name": "accountStatus",
      "type": "string",
      "description": "Membership status.",
      "source": {
        "from": "readout",
        "label": {
          "mode": "contains",
          "value": "Status",
          "caseSensitive": false
        }
      },
      "transform": "upper",
      "required": true,
      "sensitivity": "internal"
    },
    {
      "name": "savingsBalance",
      "type": "number",
      "description": "Current balance of the share savings account in dollars.",
      "source": {
        "from": "table",
        "whereColumn": "ACCOUNT TYPE",
        "whereEquals": {
          "mode": "contains",
          "value": "SHARE SAVINGS",
          "caseSensitive": false
        },
        "selectColumn": "CURRENT BALANCE"
      },
      "transform": "money",
      "required": true,
      "sensitivity": "internal"
    }
  ],
  "preconditions": [],
  "steps": [
    {
      "id": "s00",
      "intent": "Open MERIDIAN Core Member Services at its entry point",
      "action": {
        "kind": "navigate",
        "url": "tn3270://127.0.0.1:4331/"
      },
      "risk": "safe",
      "waitFor": {
        "type": "nodeExists",
        "target": {
          "role": "textbox",
          "name": "Operator ID",
          "nameMatch": "exact",
          "framePath": []
        }
      },
      "optional": false,
      "timeoutMs": 20000,
      "retry": {
        "attempts": 2,
        "backoffMs": 800
      }
    },
    {
      "id": "s01",
      "intent": "Enter the operator ID on the sign-on screen",
      "action": {
        "kind": "type",
        "target": {
          "role": "textbox",
          "name": "Operator ID",
          "nameMatch": "exact",
          "framePath": []
        },
        "secretRef": "«redacted»",
        "clearFirst": true
      },
      "risk": "safe",
      "waitFor": {
        "type": "nodeExists",
        "target": {
          "role": "textbox",
          "name": "Password",
          "nameMatch": "exact",
          "framePath": []
        }
      },
      "optional": false,
      "timeoutMs": 15000,
      "retry": {
        "attempts": 2,
        "backoffMs": 600
      }
    },
    {
      "id": "s02",
      "intent": "Enter the operator password on the sign-on screen",
      "action": {
        "kind": "type",
        "target": {
          "role": "textbox",
          "name": "Password",
          "nameMatch": "exact",
          "framePath": []
        },
        "secretRef": "«redacted»",
        "clearFirst": true
      },
      "risk": "safe",
      "waitFor": {
        "type": "nodeExists",
        "target": {
          "role": "button",
          "name": "Sign On",
          "nameMatch": "exact",
          "framePath": []
        }
      },
      "optional": false,
      "timeoutMs": 15000,
      "retry": {
        "attempts": 2,
        "backoffMs": 600
      }
    },
    {
      "id": "s03",
      "intent": "Submit the sign-on screen",
      "action": {
        "kind": "click",
        "target": {
          "role": "button",
          "name": "Sign On",
          "nameMatch": "exact",
          "framePath": []
        }
      },
      "risk": "safe",
      "waitFor": {
        "type": "nodeExists",
        "target": {
          "role": "textbox",
          "name": "Member Number",
          "nameMatch": "exact",
          "framePath": []
        }
      },
      "optional": false,
      "timeoutMs": 15000,
      "retry": {
        "attempts": 2,
        "backoffMs": 600
      }
    },
    {
      "id": "s04",
      "intent": "Enter the member number into the inquiry field",
      "action": {
        "kind": "type",
        "target": {
          "role": "textbox",
          "name": "Member Number",
          "nameMatch": "exact",
          "framePath": []
        },
        "text": "{{memberId}}",
        "clearFirst": true
      },
      "risk": "safe",
      "waitFor": {
        "type": "nodeExists",
        "target": {
          "role": "button",
          "name": "Search",
          "nameMatch": "exact",
          "framePath": []
        }
      },
      "optional": false,
      "timeoutMs": 15000,
      "retry": {
        "attempts": 2,
        "backoffMs": 600
      }
    },
    {
      "id": "s05",
      "intent": "Run the member search",
      "action": {
        "kind": "click",
        "target": {
          "role": "button",
          "name": "Search",
          "nameMatch": "exact",
          "framePath": []
        }
      },
      "risk": "safe",
      "waitFor": {
        "type": "urlMatches",
        "value": {
          "mode": "contains",
          "value": "/MEMBER_DETAIL",
          "caseSensitive": false
        }
      },
      "optional": false,
      "timeoutMs": 15000,
      "retry": {
        "attempts": 2,
        "backoffMs": 600
      }
    }
  ],
  "checkpoint": {
    "type": "all",
    "of": [
      {
        "type": "textMatches",
        "value": {
          "mode": "contains",
          "value": "MEMBER DETAIL",
          "caseSensitive": false
        }
      },
      {
        "type": "readoutMatches",
        "label": {
          "mode": "contains",
          "value": "Member Name",
          "caseSensitive": false
        },
        "value": {
          "mode": "regex",
          "value": ".",
          "caseSensitive": false
        }
      }
    ]
  },
  "outcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "No member record exists for the number supplied.",
      "when": {
        "type": "textMatches",
        "value": {
          "mode": "contains",
          "value": "MCS-0404",
          "caseSensitive": false
        }
      },
      "classification": "business",
      "afterSteps": [],
      "terminal": true,
      "outputs": [],
      "verified": true
    },
    {
      "code": "MEMBER_RESTRICTED",
      "description": "The operator is not authorised to view this member record.",
      "when": {
        "type": "textMatches",
        "value": {
          "mode": "contains",
          "value": "MCS-0403",
          "caseSensitive": false
        }
      },
      "classification": "business",
      "afterSteps": [],
      "terminal": true,
      "outputs": [],
      "verified": true
    }
  ],
  "interstitials": [],
  "policy": {
    "allowedOrigins": [
      "tn3270://127.0.0.1:4331"
    ],
    "maxSteps": 20,
    "confirmAtRisk": "irreversible"
  },
